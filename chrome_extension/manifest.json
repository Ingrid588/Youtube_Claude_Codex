{
  "manifest_version": 3,
  "name": "YouTube\u5b9e\u65f6\u4e2d\u6587\u914d\u97f3 Codex",
  "version": "0.99",
  "version_name": "0.99-cache-continuity-r12",
  "description": "\u8bfb\u53d6YouTube\u5b57\u5e55\uff0c\u8c03\u7528\u7ffb\u8bd1\u4e0e\u914d\u97f3\u670d\u52a1\uff0c\u5b9e\u73b0\u5b9e\u65f6\u4e2d\u6587\u914d\u97f3\u3002",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
