    "http://127.0.0.1:8766/*",
    "http://localhost:8765/*",
    "http://localhost:8766/*",
    "https://dub-server-921963653375.us-central1.run.app/*",
    "https://ingrid919-dub-server.hf.space/*",
    "https://ingrid919-read-video-tts.hf.space/*",
    "https://www.youtube.com/*",
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "\u5b9e\u65f6\u914d\u97f3 Codex \u8bbe\u7f6e"
  },
  "content_scripts": [
    {
      "matches": [
